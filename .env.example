# Copy to .env and adjust. Real environment variables override these values.
# No API keys are needed: story scripts are supplied as JSON.

# Render settings (the spec's defaults)
CHATSHORTS_WIDTH=1080
CHATSHORTS_HEIGHT=1920
CHATSHORTS_FPS=30

# Directories (relative to the project root)
CHATSHORTS_TEMP_DIR=temp
CHATSHORTS_OUTPUT_DIR=output
# CHATSHORTS_DB=temp/chatshorts.sqlite

# Tool overrides. Leave blank to use the bundled FFmpeg/ffprobe and auto-detect Chrome.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Story provider. "manual" = story JSON you supply (the only provider today).
STORY_PROVIDER=manual
